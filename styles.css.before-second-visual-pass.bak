:root {
  color-scheme: light;
  --ink: #172b3a;
  --muted: #6b7b88;
  --navy: #102a43;
  --navy-light: #1c4058;
  --teal: #b6e4d4;
  --teal-deep: #167b68;
  --orange: #ed8d5c;
  --paper: #f6f8f7;
  --line: #e5ebe8;
  --white: #fff;
  --shadow: 0 18px 50px rgba(25, 49, 65, .09);
  font-family: "DM Sans", sans-serif;
  color: var(--ink);
  background: var(--paper);
  font-synthesis: none;
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; background: var(--paper); }
button, input, select, textarea { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
a { color: inherit; text-decoration: none; }
button { cursor: pointer; }
img { display: block; max-width: 100%; }
.container { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

.announcement { padding: 9px 16px; text-align: center; color: #e8f4f0; background: var(--navy); font-size: 12px; letter-spacing: .02em; }
.announcement span { padding: 0 8px; color: var(--teal); }
.site-header { position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,.97); box-shadow: 0 1px 0 var(--line); backdrop-filter: blur(10px); }
.header-main { min-height: 83px; display: flex; align-items: center; gap: 38px; }
.brand { flex: 0 0 188px; display: inline-flex; align-items: center; gap: 10px; font: 800 27px/1 "Manrope", sans-serif; letter-spacing: -.07em; color: var(--navy); }
.brand > span:last-child { position: relative; }
.brand-mark { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 13px; background: var(--teal); color: var(--navy); font-size: 22px; letter-spacing: 0; }
.brand-period { color: var(--orange); }
.brand small { display: block; margin-top: 6px; font: 700 8px/1 "DM Sans", sans-serif; letter-spacing: .12em; color: #71818a; }
.search-form { height: 44px; display: flex; flex: 1; max-width: 545px; border: 1px solid #dfe8e4; border-radius: 12px; background: #f8faf9; overflow: hidden; }
.search-form:focus-within { border-color: var(--teal-deep); box-shadow: 0 0 0 3px rgba(22,123,104,.1); }
.search-form input { width: 100%; padding: 0 15px; border: 0; outline: 0; background: transparent; font-size: 14px; }
.search-form input::placeholder { color: #87959b; }
.search-form button { width: 50px; border: 0; color: var(--navy); background: transparent; font-size: 27px; }
.header-actions { display: flex; align-items: center; gap: 24px; margin-left: auto; font-size: 13px; font-weight: 600; }
.account-slot, #account-slot { display: flex; align-items: center; gap: 13px; white-space: nowrap; }
.account-name { max-width: 100px; overflow: hidden; text-overflow: ellipsis; color: var(--navy); }
.text-action { padding: 5px 0; border: 0; background: none; color: var(--muted); font-size: 12px; }
.text-action:hover, .signin-link:hover { color: var(--teal-deep); }
.signin-link { color: var(--navy); }
.register-link { color: var(--teal-deep); }
.cart-link { display: flex; align-items: center; gap: 6px; position: relative; }
.cart-icon { font-size: 23px; transform: rotate(180deg); }
.cart-count { display: grid; place-items: center; width: 19px; height: 19px; border-radius: 50%; background: var(--orange); color: white; font-size: 10px; }
.category-nav { border-top: 1px solid #f0f2f1; }
.category-inner { min-height: 43px; display: flex; align-items: center; gap: 30px; overflow-x: auto; scrollbar-width: none; }
.category-inner::-webkit-scrollbar { display: none; }
.category-button { height: 43px; padding: 0 1px; border: 0; border-bottom: 2px solid transparent; background: transparent; color: #536571; font-size: 12px; white-space: nowrap; }
.category-button:hover, .category-button.is-active { border-color: var(--teal-deep); color: var(--navy); }
.page-content { min-height: 68vh; padding-block: 30px 68px; outline: none; }
.site-footer { padding: 26px 0; border-top: 1px solid var(--line); background: #fff; }
.footer-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; color: var(--muted); font-size: 11px; }
.footer-brand { flex-basis: auto; font-size: 21px; }
.footer-brand .brand-mark { width: 30px; height: 30px; border-radius: 10px; font-size: 17px; }
.footer-inner p { margin: 0; }

.hero { position: relative; display: grid; grid-template-columns: 1.03fr .97fr; min-height: 348px; overflow: hidden; border-radius: 20px; background: #dcefe8; }
.hero-copy { z-index: 1; align-self: center; padding: 38px 0 40px 54px; }
.eyebrow { margin: 0 0 13px; color: var(--teal-deep); font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
.hero h1, .page-heading, .product-title { margin: 0; color: var(--navy); font-family: "Manrope", sans-serif; letter-spacing: -.045em; }
.hero h1 { max-width: 440px; font-size: clamp(32px, 4vw, 49px); line-height: 1.1; }
.hero-copy > p:not(.eyebrow) { max-width: 370px; margin: 16px 0 24px; color: #536d72; font-size: 14px; line-height: 1.7; }
.hero-image { min-height: 348px; background: linear-gradient(90deg, #dcefe8 0%, rgba(220,239,232,.12) 25%), url("https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?auto=format&fit=crop&w=1100&q=85") center 48%/cover; }
.button { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 0 20px; border: 1px solid transparent; border-radius: 10px; font-size: 13px; font-weight: 700; transition: transform .15s, background .15s, box-shadow .15s; }
.button:hover { transform: translateY(-1px); }
.button-primary { background: var(--navy); color: white; }
.button-primary:hover { background: var(--navy-light); box-shadow: 0 7px 18px rgba(16,42,67,.14); }
.button-accent { background: var(--teal-deep); color: white; }
.button-accent:hover { background: #126858; }
.button-outline { border-color: #d8e1dd; background: white; color: var(--navy); }
.button-outline:hover { border-color: #93b5a8; }
.button-danger { background: #fff1ed; color: #a5432e; }
.button-block { width: 100%; }
.button:disabled { cursor: not-allowed; opacity: .55; transform: none; }
.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin: 40px 0 18px; }
.section-heading h2 { margin: 0; color: var(--navy); font: 800 23px/1.2 "Manrope", sans-serif; letter-spacing: -.04em; }
.section-heading p { margin: 6px 0 0; color: var(--muted); font-size: 12px; }
.link-arrow { color: var(--teal-deep); font-size: 12px; font-weight: 700; }
.product-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
.product-card { min-width: 0; overflow: hidden; border: 1px solid #edf0ee; border-radius: 14px; background: #fff; transition: transform .18s, box-shadow .18s; }
.product-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
.product-card-image { position: relative; display: block; aspect-ratio: 1.16; overflow: hidden; background: #eaf0ed; }
.product-card-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
.product-card:hover .product-card-image img { transform: scale(1.04); }
.product-tag { position: absolute; top: 12px; left: 12px; padding: 6px 9px; border-radius: 20px; background: rgba(255,255,255,.92); color: var(--navy); font-size: 9px; font-weight: 700; }
.product-card-body { padding: 13px 14px 15px; }
.product-category { color: #82918f; font-size: 10px; }
.product-card h3 { min-height: 38px; margin: 5px 0 9px; color: var(--navy); font: 700 13px/1.45 "Manrope", sans-serif; }
.product-card-bottom { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.price { color: var(--navy); font-size: 16px; font-weight: 700; }
.old-price { margin-left: 6px; color: #9ca8a8; font-size: 11px; font-weight: 400; text-decoration: line-through; }
.quick-add { width: 32px; height: 32px; border: 0; border-radius: 9px; background: #edf6f2; color: var(--teal-deep); font-size: 21px; }
.quick-add:hover { background: var(--teal); }
.benefit-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-top: 28px; }
.benefit { display: flex; align-items: center; gap: 12px; padding: 15px; border: 1px solid var(--line); border-radius: 12px; background: white; }
.benefit-icon { display: grid; place-items: center; width: 36px; height: 36px; flex: 0 0 36px; border-radius: 11px; background: #eaf5ef; color: var(--teal-deep); font-size: 17px; }
.benefit strong { display: block; color: var(--navy); font-size: 11px; }
.benefit span:last-child { display: block; margin-top: 3px; color: var(--muted); font-size: 10px; }

.page-heading { margin-bottom: 8px; font-size: 30px; }
.page-intro { margin: 0 0 25px; color: var(--muted); font-size: 13px; line-height: 1.6; }
.auth-wrap { max-width: 470px; margin: 12px auto 28px; }
.auth-card, .panel { padding: 29px; border: 1px solid var(--line); border-radius: 16px; background: #fff; box-shadow: 0 8px 28px rgba(25,49,65,.04); }
.auth-card .brand { margin-bottom: 25px; }
.auth-card h1 { margin: 0 0 7px; color: var(--navy); font: 800 25px "Manrope", sans-serif; letter-spacing: -.04em; }
.auth-card > p { margin: 0 0 22px; color: var(--muted); font-size: 13px; }
.form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; }
.field { display: flex; flex-direction: column; gap: 7px; }
.field.full { grid-column: 1 / -1; }
.field label { color: #344d5c; font-size: 11px; font-weight: 700; }
.field input, .field select, .field textarea { width: 100%; min-height: 43px; padding: 10px 12px; border: 1px solid #dce5e1; border-radius: 9px; outline: 0; background: #fff; color: var(--ink); font-size: 13px; }
.field textarea { min-height: 78px; resize: vertical; }
.field input:focus, .field select:focus, .field textarea:focus { border-color: var(--teal-deep); box-shadow: 0 0 0 3px rgba(22,123,104,.1); }
.field-hint { color: var(--muted); font-size: 10px; line-height: 1.5; }
.form-error { min-height: 18px; margin: 9px 0 0; color: #b43e2d; font-size: 12px; }
.auth-submit { margin-top: 12px; }
.auth-switch { margin: 18px 0 0; text-align: center; color: var(--muted); font-size: 12px; }
.auth-switch a { color: var(--teal-deep); font-weight: 700; }
.demo-note { margin-top: 15px; padding: 11px; border-radius: 9px; background: #f4f8f6; color: #60716f; font-size: 10px; line-height: 1.55; }
.breadcrumbs { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; color: #86938f; font-size: 11px; }
.breadcrumbs a { color: var(--teal-deep); }
.product-detail { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; padding: 24px; border: 1px solid var(--line); border-radius: 16px; background: white; }
.product-detail-image { aspect-ratio: 1 / .88; overflow: hidden; border-radius: 12px; background: #edf2ef; }
.product-detail-image img { width: 100%; height: 100%; object-fit: cover; }
.product-detail-copy { padding: 15px 12px 10px 0; }
.product-title { margin: 9px 0 10px; font-size: clamp(25px, 3vw, 34px); line-height: 1.2; }
.rating { color: #c7822d; font-size: 12px; }
.detail-price { margin: 20px 0; font-size: 24px; }
.detail-description { color: #657782; font-size: 13px; line-height: 1.8; }
.availability { margin: 17px 0; color: var(--teal-deep); font-size: 12px; font-weight: 700; }
.qty-field { width: 86px; margin: 14px 0 16px; }
.detail-actions { display: flex; flex-wrap: wrap; gap: 10px; }
.detail-actions .button { flex: 1 1 170px; }
.trust-note { margin-top: 19px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: 11px; line-height: 1.7; }
.empty-state { padding: 55px 20px; border: 1px dashed #d3dfda; border-radius: 15px; background: rgba(255,255,255,.65); text-align: center; }
.empty-state .empty-icon { font-size: 35px; }
.empty-state h2 { margin: 12px 0 7px; color: var(--navy); font: 800 21px "Manrope", sans-serif; }
.empty-state p { margin: 0 auto 20px; color: var(--muted); font-size: 13px; }
.cart-layout, .checkout-layout { display: grid; grid-template-columns: minmax(0, 1fr) 340px; align-items: start; gap: 22px; }
.cart-list { display: grid; gap: 12px; }
.cart-item { display: grid; grid-template-columns: 92px minmax(0, 1fr) auto; gap: 16px; align-items: center; padding: 13px; border: 1px solid var(--line); border-radius: 12px; background: white; }
.cart-item img { width: 92px; height: 92px; object-fit: cover; border-radius: 9px; background: #edf2ef; }
.cart-item h3 { margin: 0 0 5px; color: var(--navy); font: 700 13px/1.4 "Manrope", sans-serif; }
.cart-item .product-category { display: block; margin-bottom: 8px; }
.cart-price { color: var(--navy); font-weight: 700; font-size: 13px; }
.cart-item-actions { display: flex; align-items: center; gap: 8px; margin-top: 9px; }
.qty-control { display: inline-flex; align-items: center; overflow: hidden; border: 1px solid #dce5e1; border-radius: 7px; }
.qty-control button { width: 28px; height: 27px; border: 0; background: white; color: var(--navy); }
.qty-control span { min-width: 25px; text-align: center; font-size: 11px; }
.remove-button { border: 0; background: transparent; color: #ad4b3b; font-size: 10px; }
.cart-item-total { align-self: start; padding-top: 5px; white-space: nowrap; }
.summary-card { padding: 21px; border: 1px solid var(--line); border-radius: 13px; background: white; }
.summary-card h2 { margin: 0 0 18px; color: var(--navy); font: 800 17px "Manrope", sans-serif; }
.summary-line { display: flex; justify-content: space-between; gap: 12px; margin: 12px 0; color: #687982; font-size: 12px; }
.summary-line strong { color: var(--navy); }
.summary-total { padding-top: 14px; margin-top: 15px; border-top: 1px solid var(--line); color: var(--navy); font-size: 14px; font-weight: 700; }
.summary-card .button { margin-top: 12px; }
.summary-note { margin: 12px 0 0; color: var(--muted); font-size: 10px; line-height: 1.5; }
.stepper { display: flex; align-items: center; margin: 0 0 25px; }
.step { display: flex; align-items: center; gap: 8px; color: #9aa6a3; font-size: 11px; white-space: nowrap; }
.step-circle { display: grid; place-items: center; width: 27px; height: 27px; border: 1px solid #d6e0db; border-radius: 50%; background: white; font-size: 10px; }
.step.is-current { color: var(--navy); font-weight: 700; }
.step.is-current .step-circle, .step.is-done .step-circle { border-color: var(--teal-deep); background: var(--teal-deep); color: white; }
.step-line { height: 1px; flex: 1; min-width: 16px; margin: 0 9px; background: #dce4e0; }
.checkout-form, .payment-options { display: grid; gap: 14px; }
.checkout-panel h2 { margin: 0 0 20px; color: var(--navy); font: 800 19px "Manrope", sans-serif; }
.checkout-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 23px; }
.payment-option { display: flex; align-items: flex-start; gap: 12px; padding: 14px; border: 1px solid var(--line); border-radius: 10px; cursor: pointer; }
.payment-option:has(input:checked) { border-color: var(--teal-deep); background: #f2faf6; }
.payment-option input { margin-top: 3px; accent-color: var(--teal-deep); }
.payment-option strong { display: block; color: var(--navy); font-size: 12px; }
.payment-option span { display: block; margin-top: 4px; color: var(--muted); font-size: 10px; line-height: 1.5; }
.payment-hint { padding: 11px 13px; border-radius: 9px; background: #f4f8f6; color: #60716f; font-size: 10px; line-height: 1.6; }
.address-preview { padding: 12px; border-radius: 9px; background: #f6f8f7; color: #5f7079; font-size: 11px; line-height: 1.6; }
.confirmation { max-width: 760px; margin: 0 auto; }
.success-banner { padding: 26px; border-radius: 15px; background: #e4f4ec; text-align: center; }
.success-icon { display: grid; place-items: center; width: 52px; height: 52px; margin: 0 auto 12px; border-radius: 50%; background: var(--teal-deep); color: white; font-size: 25px; }
.success-banner h1 { margin: 0 0 7px; color: var(--navy); font: 800 26px "Manrope", sans-serif; }
.success-banner p { margin: 0; color: #58716c; font-size: 12px; }
.order-number { display: inline-block; margin-top: 12px; padding: 7px 11px; border-radius: 7px; background: white; color: var(--navy); font-size: 12px; font-weight: 700; letter-spacing: .05em; }
.order-detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 16px; }
.order-info { padding: 17px; border: 1px solid var(--line); border-radius: 11px; background: white; }
.order-info h3 { margin: 0 0 9px; color: var(--navy); font-size: 12px; }
.order-info p { margin: 0; color: #687982; font-size: 11px; line-height: 1.7; }
.order-products { display: grid; gap: 9px; margin-top: 9px; }
.order-product { display: flex; justify-content: space-between; gap: 12px; color: #536570; font-size: 11px; }
.confirmation-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
.orders-list { display: grid; gap: 13px; }
.order-card { padding: 17px; border: 1px solid var(--line); border-radius: 12px; background: white; }
.order-card-head { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
.order-card-head strong { color: var(--navy); font-size: 12px; }
.order-card-head span, .order-card-body { color: var(--muted); font-size: 11px; }
.order-card-body { display: flex; justify-content: space-between; gap: 12px; padding-top: 12px; }
.toast-region { position: fixed; right: 22px; bottom: 22px; z-index: 50; display: grid; gap: 8px; }
.toast { max-width: min(370px, calc(100vw - 32px)); padding: 13px 17px; border: 1px solid #d8e6df; border-radius: 10px; background: white; box-shadow: var(--shadow); color: var(--navy); font-size: 12px; animation: toast-in .2s ease-out; }
.toast.error { border-color: #f0c7bb; color: #943b2d; }
@keyframes toast-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

@media (max-width: 900px) {
  .header-main { gap: 20px; }
  .brand { flex-basis: 148px; }
  .header-actions { gap: 14px; }
  .account-name { display: none; }
  .product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cart-layout, .checkout-layout { grid-template-columns: minmax(0, 1fr) 290px; gap: 15px; }
  .product-detail { gap: 25px; }
}
@media (max-width: 680px) {
  .container { width: min(100% - 30px, 520px); }
  .announcement { font-size: 10px; }
  .header-main { min-height: 67px; display: grid; grid-template-columns: 1fr auto; gap: 10px 12px; padding-block: 10px; }
  .brand { grid-column: 1; grid-row: 1; flex-basis: auto; font-size: 23px; }
  .brand-mark { width: 33px; height: 33px; border-radius: 11px; font-size: 19px; }
  .brand small { font-size: 7px; }
  .header-actions { grid-column: 2; grid-row: 1; gap: 12px; font-size: 11px; }
  .account-slot, #account-slot { gap: 8px; }
  .text-action { font-size: 10px; }
  .cart-link { gap: 4px; }
  .cart-icon { font-size: 19px; }
  .search-form { grid-column: 1 / -1; grid-row: 2; max-width: none; height: 39px; }
  .category-inner { min-height: 40px; gap: 22px; }
  .category-button { height: 40px; }
  .page-content { padding-block: 18px 45px; }
  .hero { grid-template-columns: 1fr; min-height: auto; }
  .hero-copy { padding: 30px 25px 24px; }
  .hero h1 { max-width: 380px; font-size: 34px; }
  .hero-copy > p:not(.eyebrow) { margin: 12px 0 18px; font-size: 12px; }
  .hero-image { min-height: 185px; background-position: center 54%; }
  .section-heading { margin-top: 31px; }
  .section-heading h2 { font-size: 20px; }
  .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 11px; }
  .product-card-body { padding: 11px; }
  .product-card h3 { min-height: 36px; font-size: 11px; }
  .product-card-image { aspect-ratio: 1.05; }
  .price { font-size: 14px; }
  .old-price { display: block; margin: 3px 0 0; }
  .benefit-row { grid-template-columns: 1fr; gap: 9px; }
  .footer-inner { flex-wrap: wrap; justify-content: flex-start; }
  .footer-inner p { flex: 1 1 200px; }
  .footer-inner > span:last-child { width: 100%; }
  .product-detail { grid-template-columns: 1fr; gap: 16px; padding: 13px; }
  .product-detail-image { aspect-ratio: 1.2; }
  .product-detail-copy { padding: 4px 5px 9px; }
  .product-title { font-size: 27px; }
  .cart-layout, .checkout-layout { grid-template-columns: 1fr; }
  .summary-card { grid-row: 1; }
  .cart-item { grid-template-columns: 70px minmax(0, 1fr); gap: 11px; }
  .cart-item img { width: 70px; height: 75px; }
  .cart-item-total { grid-column: 2; justify-self: start; margin-top: -5px; padding: 0; }
  .summary-card { padding: 17px; }
  .step { gap: 5px; font-size: 9px; }
  .step-circle { width: 23px; height: 23px; }
  .step-line { min-width: 8px; margin: 0 5px; }
  .auth-card, .panel { padding: 21px; }
  .page-heading { font-size: 26px; }
}
@media (max-width: 390px) {
  .header-actions { gap: 8px; }
  .register-link { display: none; }
  .header-main { column-gap: 6px; }
  .product-grid { gap: 8px; }
  .step { font-size: 8px; }
}

/* Ajustes de tienda */
:root {
  --settings-surface: #fff;
  --settings-surface-soft: #f6f8f7;
  --settings-border: #e5ebe8;
  --settings-text: #172b3a;
  --settings-subtle: #6b7b88;
  transition: color .2s ease, background-color .2s ease;
}
body, .site-header, .site-footer, .product-card, .benefit, .auth-card, .panel, .summary-card,
.cart-item, .order-info, .order-card, .empty-state, .product-detail, .settings-card, .settings-index {
  transition: color .2s ease, background-color .2s ease, border-color .2s ease;
}
.settings-page { max-width: 1040px; margin: 0 auto; }
.settings-page-heading { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 21px; }
.settings-page-heading .page-intro { margin-bottom: 0; }
.settings-back { flex: 0 0 auto; }
.settings-layout { display: grid; grid-template-columns: 185px minmax(0, 1fr); align-items: start; gap: 18px; }
.settings-index { position: sticky; top: 145px; display: grid; gap: 4px; padding: 10px; border: 1px solid var(--settings-border); border-radius: 13px; background: var(--settings-surface); }
.settings-index a { display: flex; align-items: center; gap: 10px; padding: 11px 10px; border-radius: 8px; color: var(--settings-subtle); font-size: 11px; font-weight: 600; }
.settings-index a:hover, .settings-index a:focus-visible { background: var(--settings-surface-soft); color: var(--teal-deep); }
.settings-sections { display: grid; gap: 14px; }
.settings-card { scroll-margin-top: 145px; padding: 22px; border: 1px solid var(--settings-border); border-radius: 13px; background: var(--settings-surface); }
.settings-section-heading { display: flex; align-items: flex-start; gap: 12px; padding-bottom: 17px; margin-bottom: 15px; border-bottom: 1px solid var(--settings-border); }
.settings-icon { display: grid; place-items: center; width: 36px; height: 36px; flex: 0 0 36px; border-radius: 11px; background: #edf6f2; color: var(--teal-deep); font-size: 17px; }
.settings-section-heading h2 { margin: 1px 0 4px; color: var(--settings-text); font: 800 16px/1.35 "Manrope", sans-serif; letter-spacing: -.025em; }
.settings-section-heading p { margin: 0; color: var(--settings-subtle); font-size: 11px; line-height: 1.55; }
.theme-picker { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; padding: 0; margin: 0; border: 0; }
.theme-choice { position: relative; display: flex; flex-direction: column; min-height: 112px; gap: 9px; padding: 13px; border: 1px solid var(--settings-border); border-radius: 10px; background: var(--settings-surface); cursor: pointer; }
.theme-choice:focus-within, .theme-choice:hover { border-color: #9bbcaf; }
.theme-choice.is-selected { border-color: var(--teal-deep); background: #f2faf6; box-shadow: 0 0 0 1px var(--teal-deep); }
.theme-choice input { position: absolute; top: 12px; right: 12px; accent-color: var(--teal-deep); }
.theme-choice-icon { color: var(--teal-deep); font-size: 18px; }
.theme-choice-copy strong { display: block; color: var(--settings-text); font-size: 11px; }
.theme-choice-copy small { display: block; margin-top: 4px; color: var(--settings-subtle); font-size: 9px; line-height: 1.4; }
.theme-choice-check { display: none; }
.theme-choice.is-selected .theme-choice-check { display: block; position: absolute; right: 12px; bottom: 11px; color: var(--teal-deep); font-size: 12px; font-weight: 700; }
.settings-inline-status { margin: 12px 0 0; color: var(--teal-deep); font-size: 10px; }
.settings-option-row, .settings-privacy-actions { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 13px 0; border-bottom: 1px solid var(--settings-border); }
.settings-option-row:last-of-type, .settings-privacy-actions:last-of-type { border-bottom: 0; }
.settings-option-row strong, .settings-privacy-actions strong, .settings-storage-info strong { display: block; color: var(--settings-text); font-size: 11px; }
.settings-option-row p, .settings-privacy-actions p, .settings-storage-info p { margin: 4px 0 0; color: var(--settings-subtle); font-size: 10px; line-height: 1.55; }
.settings-select-label select { min-width: 125px; min-height: 37px; padding: 7px 27px 7px 10px; border: 1px solid var(--settings-border); border-radius: 8px; background: var(--settings-surface); color: var(--settings-text); font-size: 11px; }
.settings-subnote { margin: 10px 0; color: var(--settings-subtle); font-size: 10px; line-height: 1.6; }
.settings-switch { position: relative; display: inline-flex; width: 42px; height: 24px; flex: 0 0 42px; cursor: pointer; }
.settings-switch input { position: absolute; width: 1px; height: 1px; opacity: 0; }
.settings-switch-track { width: 42px; height: 24px; border-radius: 20px; background: #bdc8c5; transition: background .18s; }
.settings-switch-track::after { content: ""; position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.2); transition: transform .18s; }
.settings-switch input:checked + .settings-switch-track { background: var(--teal-deep); }
.settings-switch input:checked + .settings-switch-track::after { transform: translateX(18px); }
.settings-switch input:focus-visible + .settings-switch-track { outline: 3px solid rgba(22,123,104,.24); outline-offset: 2px; }
.settings-unavailable { padding: 6px 9px; border-radius: 20px; background: var(--settings-surface-soft); color: var(--settings-subtle); font-size: 9px; }
.settings-storage-info { padding: 14px; border-radius: 9px; background: var(--settings-surface-soft); }
.settings-storage-info small { display: block; margin-top: 7px; color: var(--settings-subtle); font-size: 9px; line-height: 1.5; }
.settings-privacy-actions { align-items: center; }
.settings-privacy-actions > div { flex: 1; }
.settings-privacy-actions .button { min-height: 36px; padding-inline: 12px; font-size: 10px; white-space: nowrap; }
.settings-demo-warning { margin-top: 14px; padding: 13px; border: 1px solid #f0ddbd; border-radius: 9px; background: #fff9ed; }
.settings-demo-warning strong { color: #785322; font-size: 10px; }
.settings-demo-warning p { margin: 5px 0 0; color: #786c58; font-size: 10px; line-height: 1.55; }
.settings-account-user { display: flex; align-items: center; gap: 12px; margin: 5px 0 15px; }
.settings-avatar { display: grid; place-items: center; width: 43px; height: 43px; border-radius: 50%; background: var(--teal); color: var(--navy); font: 700 17px "Manrope", sans-serif; }
.settings-account-user strong, .settings-account-user span:not(.settings-avatar) { display: block; }
.settings-account-user strong { color: var(--settings-text); font-size: 12px; }
.settings-account-user div span { margin-top: 4px; color: var(--settings-subtle); font-size: 10px; }
.settings-guest { color: var(--settings-subtle); font-size: 11px; line-height: 1.6; }
.settings-button-row { display: flex; flex-wrap: wrap; gap: 9px; }
.settings-button-row .button { min-height: 38px; font-size: 11px; }
.settings-bottom { display: flex; justify-content: flex-start; margin-top: 16px; }
.settings-nav-link { display: inline-flex; align-items: center; gap: 4px; }
.search-form { min-width: 0; }
.search-form input { min-width: 0; }

:root[data-theme="dark"] {
  color-scheme: dark;
  --ink: #e5edf2;
  --muted: #a3b2bc;
  --navy: #e7f0f5;
  --navy-light: #d3e1e8;
  --teal: #315e57;
  --teal-deep: #65c5a5;
  --orange: #f1a276;
  --paper: #111c27;
  --line: #293844;
  --white: #182530;
  --shadow: 0 18px 50px rgba(0,0,0,.25);
  --settings-surface: #182530;
  --settings-surface-soft: #202f3a;
  --settings-border: #30414d;
  --settings-text: #e5edf2;
  --settings-subtle: #a3b2bc;
}
:root[data-theme="dark"] body { color: var(--ink); background: var(--paper); }
:root[data-theme="dark"] .announcement { background: #0b1823; color: #e8f4f0; }
:root[data-theme="dark"] .site-header { background: rgba(20,32,43,.97); }
:root[data-theme="dark"] .site-footer,
:root[data-theme="dark"] .product-card,
:root[data-theme="dark"] .benefit,
:root[data-theme="dark"] .auth-card,
:root[data-theme="dark"] .panel,
:root[data-theme="dark"] .summary-card,
:root[data-theme="dark"] .cart-item,
:root[data-theme="dark"] .order-info,
:root[data-theme="dark"] .order-card,
:root[data-theme="dark"] .product-detail,
:root[data-theme="dark"] .settings-card,
:root[data-theme="dark"] .settings-index { border-color: var(--settings-border); background: var(--settings-surface); }
:root[data-theme="dark"] .empty-state { border-color: var(--settings-border); background: rgba(24,37,48,.72); }
:root[data-theme="dark"] .category-nav,
:root[data-theme="dark"] .search-form,
:root[data-theme="dark"] .field input,
:root[data-theme="dark"] .field select,
:root[data-theme="dark"] .field textarea,
:root[data-theme="dark"] .settings-select-label select,
:root[data-theme="dark"] .theme-choice { border-color: var(--settings-border); background-color: var(--settings-surface-soft); color: var(--settings-text); }
:root[data-theme="dark"] .category-button,
:root[data-theme="dark"] .text-action,
:root[data-theme="dark"] .section-heading p,
:root[data-theme="dark"] .product-category,
:root[data-theme="dark"] .detail-description,
:root[data-theme="dark"] .summary-line,
:root[data-theme="dark"] .breadcrumbs,
:root[data-theme="dark"] .auth-card > p,
:root[data-theme="dark"] .field label,
:root[data-theme="dark"] .page-intro,
:root[data-theme="dark"] .footer-inner,
:root[data-theme="dark"] .settings-section-heading p,
:root[data-theme="dark"] .settings-option-row p,
:root[data-theme="dark"] .settings-privacy-actions p,
:root[data-theme="dark"] .settings-subnote,
:root[data-theme="dark"] .settings-storage-info p,
:root[data-theme="dark"] .settings-storage-info small,
:root[data-theme="dark"] .settings-account-user div span { color: var(--settings-subtle); }
:root[data-theme="dark"] .hero { background: #203a3c; }
:root[data-theme="dark"] .hero-image { background-image: linear-gradient(90deg, #203a3c 0%, rgba(32,58,60,.18) 30%), url("https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?auto=format&fit=crop&w=1100&q=85"); }
:root[data-theme="dark"] .hero-copy > p:not(.eyebrow) { color: #bed0cc; }
:root[data-theme="dark"] .button-primary { background: #d7ebe4; color: #14283a; }
:root[data-theme="dark"] .button-primary:hover { background: #eff8f4; }
:root[data-theme="dark"] .button-accent { background: #176b5c; color: #fff; }
:root[data-theme="dark"] .button-accent:hover { background: #125648; }
:root[data-theme="dark"] .button-danger { background: #4b2b2a; color: #ffb6a7; }
:root[data-theme="dark"] .button-outline,
:root[data-theme="dark"] .qty-control,
:root[data-theme="dark"] .qty-control button { border-color: var(--settings-border); background: var(--settings-surface-soft); color: var(--settings-text); }
:root[data-theme="dark"] .quick-add,
:root[data-theme="dark"] .benefit-icon,
:root[data-theme="dark"] .settings-icon { background: #29453f; color: #91e0c1; }
:root[data-theme="dark"] .quick-add:hover { background: #315e57; }
:root[data-theme="dark"] .product-tag { background: rgba(24,37,48,.94); color: var(--settings-text); }
:root[data-theme="dark"] .payment-option { border-color: var(--settings-border); background: var(--settings-surface); }
:root[data-theme="dark"] .payment-option:has(input:checked),
:root[data-theme="dark"] .theme-choice.is-selected { border-color: var(--teal-deep); background: #203a34; }
:root[data-theme="dark"] .payment-option strong,
:root[data-theme="dark"] .payment-option span,
:root[data-theme="dark"] .order-card-head strong,
:root[data-theme="dark"] .order-card-body,
:root[data-theme="dark"] .product-card h3 { color: var(--settings-text); }
:root[data-theme="dark"] .payment-hint,
:root[data-theme="dark"] .address-preview,
:root[data-theme="dark"] .demo-note,
:root[data-theme="dark"] .settings-storage-info { background: var(--settings-surface-soft); color: var(--settings-subtle); }
:root[data-theme="dark"] .auth-switch,
:root[data-theme="dark"] .field-hint,
:root[data-theme="dark"] .summary-note,
:root[data-theme="dark"] .trust-note { color: var(--settings-subtle); }
:root[data-theme="dark"] .settings-demo-warning { border-color: #625338; background: #332e24; }
:root[data-theme="dark"] .settings-demo-warning strong,
:root[data-theme="dark"] .settings-demo-warning p { color: #e3c995; }
:root[data-theme="dark"] .settings-unavailable { background: var(--settings-surface-soft); color: var(--settings-subtle); }
:root[data-theme="dark"] .cart-item img,
:root[data-theme="dark"] .product-detail-image { background: #202f3a; }
:root[data-theme="dark"] .step-circle { border-color: var(--settings-border); background: var(--settings-surface-soft); color: var(--settings-text); }
:root[data-theme="dark"] .step.is-current .step-circle,
:root[data-theme="dark"] .step.is-done .step-circle { border-color: var(--teal-deep); background: #176b5c; color: #fff; }
:root[data-theme="dark"] .step-line { background: var(--settings-border); }
:root[data-theme="dark"] .success-banner { background: #203a34; }
:root[data-theme="dark"] .success-banner h1,
:root[data-theme="dark"] .success-banner p { color: #d4eee3; }
:root[data-theme="dark"] .success-icon { background: #24866d; }
:root[data-theme="dark"] .order-number { background: #182530; color: #e5edf2; }
:root[data-theme="dark"] .toast { border-color: var(--settings-border); background: #202f3a; color: #e5edf2; }
:root[data-theme="dark"] .toast.error { color: #ffb6a7; }

:root[data-text-size="small"] .page-content { font-size:  .94em; }
:root[data-text-size="large"] .page-content { font-size: 1.08em; }
:root[data-text-size="small"] .page-content :is(h1, h2, h3, p, a, button, label, input, select, textarea, .product-category, .price, .summary-line, .settings-option-row strong, .settings-privacy-actions strong, .settings-storage-info strong, .theme-choice-copy strong) { font-size: .94em; }
:root[data-text-size="large"] .page-content :is(h1, h2, h3, p, a, button, label, input, select, textarea, .product-category, .price, .summary-line, .settings-option-row strong, .settings-privacy-actions strong, .settings-storage-info strong, .theme-choice-copy strong) { font-size: 1.08em; }
.settings-no-motion *, .settings-no-motion *::before, .settings-no-motion *::after {
  scroll-behavior: auto !important;
  animation-duration: .01ms !important;
  animation-iteration-count: 1 !important;
  transition-duration: .01ms !important;
}

@media (max-width: 760px) {
  .settings-page-heading { align-items: flex-start; flex-direction: column; gap: 12px; }
  .settings-layout { grid-template-columns: 1fr; gap: 12px; }
  .settings-index { position: static; display: flex; gap: 4px; overflow-x: auto; padding: 7px; }
  .settings-index a { flex: 0 0 auto; padding: 9px; }
  .settings-index a span { display: inline; }
  .settings-card { scroll-margin-top: 130px; padding: 17px; }
}
@media (max-width: 680px) {
  .settings-nav-label { display: none; }
  .settings-nav-link { font-size: 16px; }
}
@media (max-width: 420px) {
  .register-link { display: none; }
}
@media (max-width: 350px) {
  .signin-link { font-size: 0; }
  .signin-link::before { content: "↪"; font-size: 16px; }
}
@media (max-width: 520px) {
  .theme-picker { grid-template-columns: 1fr; }
  .theme-choice { min-height: 76px; flex-direction: row; align-items: center; padding-right: 37px; }
  .theme-choice-copy { flex: 1; }
  .settings-option-row, .settings-privacy-actions { align-items: flex-start; }
  .settings-select-label select { min-width: 110px; }
  .settings-privacy-actions { flex-direction: column; gap: 10px; }
  .settings-privacy-actions .button { align-self: flex-start; }
  .settings-account-user { align-items: flex-start; }
}

/* Catálogo extendido y áreas personales */
.category-inner { gap: 22px; }
.feature-nav-link { display: inline-flex; align-items: center; gap: 5px; color: var(--muted); font-size: 11px; font-weight: 600; white-space: nowrap; }
.feature-nav-link:hover { color: var(--teal-deep); }
.notification-link { position: relative; display: grid; place-items: center; width: 32px; height: 36px; border-radius: 9px; color: var(--navy); font-size: 21px; }
.notification-link:hover { background: #edf6f2; }
.notification-count { position: absolute; top: 0; right: -3px; display: grid; place-items: center; min-width: 17px; height: 17px; padding: 0 4px; border: 2px solid white; border-radius: 20px; background: #d95845; color: white; font-size: 9px; font-weight: 700; }
.notification-count[hidden] { display: none; }
.product-card-media { position: relative; }
.favorite-toggle { position: absolute; top: 10px; right: 10px; z-index: 2; display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid rgba(23,43,58,.08); border-radius: 50%; background: rgba(255,255,255,.94); color: #5f727b; font-size: 19px; line-height: 1; }
.favorite-toggle:hover, .favorite-toggle.is-favorite, .favorite-detail.is-favorite { color: #c44953; }
.favorite-detail { color: #a94654; }
.product-card-rating { display: flex; align-items: center; gap: 6px; min-height: 16px; margin: -2px 0 9px; color: var(--muted); font-size: 9px; }
.feature-rating-stars { color: #c7822d; letter-spacing: .04em; }
.feature-rating-empty { color: var(--muted); }
.detail-actions-feature { margin: 0 0 9px; }
.detail-actions-feature .button { flex: 0 0 auto; min-height: 38px; }
.feature-panel { padding: 21px; border: 1px solid var(--line); border-radius: 13px; background: white; box-shadow: 0 8px 28px rgba(25,49,65,.035); }
.feature-section-heading { display: flex; align-items: start; justify-content: space-between; gap: 14px; padding-bottom: 15px; margin-bottom: 15px; border-bottom: 1px solid var(--line); }
.feature-section-heading h2 { margin: 0; color: var(--navy); font: 800 19px/1.3 "Manrope", sans-serif; letter-spacing: -.035em; }
.feature-section-heading h3 { margin: 0; }
.feature-section-heading p { margin: 5px 0 0; color: var(--muted); font-size: 11px; line-height: 1.6; }
.feature-muted { color: var(--muted); font-size: 11px; line-height: 1.65; }
.feature-muted a { color: var(--teal-deep); font-weight: 700; }
.feature-empty { padding: 40px 22px; border: 1px dashed #d3dfda; border-radius: 13px; background: rgba(255,255,255,.65); text-align: center; }
.feature-empty.compact { padding: 20px; text-align: left; }
.feature-empty > span { color: var(--teal-deep); font-size: 32px; }
.feature-empty h2 { margin: 10px 0 7px; color: var(--navy); font: 800 20px "Manrope", sans-serif; }
.feature-empty p { margin: 0 auto 16px; color: var(--muted); font-size: 12px; line-height: 1.6; }
.feature-empty small { color: var(--muted); font-size: 10px; }
.feature-list { display: grid; gap: 13px; }
.feature-rating-empty, .feature-muted .feature-rating-stars { display: inline-block; }
.catalog-filters { display: grid; grid-template-columns: 1.1fr .8fr .8fr 1.4fr auto; gap: 10px; align-items: end; padding: 14px; margin: 0 0 17px; border: 1px solid var(--line); border-radius: 12px; background: white; }
.filter-control { display: grid; gap: 5px; min-width: 0; color: var(--muted); font-size: 10px; font-weight: 600; }
.filter-control input, .filter-control select { width: 100%; min-width: 0; height: 37px; padding: 7px 9px; border: 1px solid #dce5e1; border-radius: 8px; background: white; color: var(--ink); font-size: 11px; }
.filter-clear { min-height: 37px; padding-inline: 11px; white-space: nowrap; font-size: 10px; }
.review-section { margin-top: 20px; }
.review-section .feature-section-heading { align-items: center; }
.review-section .feature-section-heading .eyebrow { margin-bottom: 5px; }
.review-list { display: grid; gap: 9px; }
.review-item { padding: 13px 0; border-bottom: 1px solid var(--line); }
.review-item:last-child { border-bottom: 0; }
.review-item-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.review-item-head strong { color: var(--navy); font-size: 12px; }
.review-item p { margin: 8px 0; color: var(--ink); font-size: 12px; line-height: 1.65; }
.review-item small { color: var(--muted); font-size: 9px; }
.review-form { max-width: 640px; padding-top: 15px; margin-top: 15px; border-top: 1px solid var(--line); }
.review-form h3 { margin: 0 0 11px; color: var(--navy); font: 700 14px "Manrope", sans-serif; }
.review-stars { display: flex; flex-direction: row-reverse; justify-content: flex-end; gap: 5px; padding: 0; margin: 0 0 13px; border: 0; }
.review-stars legend { margin-bottom: 5px; color: var(--muted); font-size: 10px; }
.review-stars label { color: #c6cfca; cursor: pointer; font-size: 25px; line-height: 1; }
.review-stars input { position: absolute; opacity: 0; }
.review-stars label:has(input:checked), .review-stars label:has(input:checked) ~ label, .review-stars label:hover, .review-stars label:hover ~ label { color: #c7822d; }
.review-stars input:focus-visible + span { outline: 2px solid var(--teal-deep); outline-offset: 2px; }
.feature-form { display: grid; gap: 12px; }
.feature-field { display: grid; gap: 6px; color: #344d5c; font-size: 10px; font-weight: 700; }
.feature-field input, .feature-field textarea { width: 100%; min-height: 40px; padding: 9px 11px; border: 1px solid #dce5e1; border-radius: 8px; outline: 0; background: white; color: var(--ink); font-size: 12px; }
.feature-field textarea { min-height: 80px; resize: vertical; }
.feature-field input:focus, .feature-field textarea:focus, .filter-control input:focus, .filter-control select:focus { border-color: var(--teal-deep); box-shadow: 0 0 0 3px rgba(22,123,104,.1); }
.feature-form-error { min-height: 0; margin: 0; color: #b43e2d; font-size: 11px; line-height: 1.5; }
.feature-form-error.is-success { color: var(--teal-deep); }
.feature-form [hidden] { display: none; }
.feature-form > .button, .feature-inline-actions .button { justify-self: start; }
.feature-disclaimer { margin: 0; color: var(--muted); font-size: 9px; line-height: 1.6; }
.account-grid { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(240px,.8fr); gap: 14px; }
.account-shortcuts { display: flex; flex-direction: column; align-items: stretch; gap: 7px; }
.account-shortcuts .feature-section-heading { width: 100%; }
.account-shortcuts > a { display: flex; align-items: center; gap: 8px; padding: 10px; border-radius: 8px; color: var(--teal-deep); font-size: 12px; font-weight: 700; }
.account-shortcuts > a span { flex: 1; color: var(--ink); }
.account-shortcuts > a:hover { background: var(--paper); }
.account-shortcuts .button { align-self: flex-start; margin-top: 10px; }
.address-panel { margin-top: 14px; }
.saved-address-list { display: grid; gap: 9px; margin-bottom: 16px; }
.saved-address { display: flex; justify-content: space-between; align-items: start; gap: 15px; padding: 12px; border: 1px solid var(--line); border-radius: 9px; }
.saved-address strong { color: var(--navy); font-size: 11px; }
.saved-address p { margin: 5px 0 0; color: var(--muted); font-size: 10px; line-height: 1.6; }
.saved-address-actions, .feature-inline-actions { display: flex; flex-wrap: wrap; gap: 7px; }
.saved-address-actions .button { min-height: 32px; padding-inline: 10px; font-size: 9px; }
.address-form { padding-top: 15px; margin-top: 15px; border-top: 1px solid var(--line); }
.saved-address-picker { margin-bottom: 14px; }
.address-form h3 { margin: 0; color: var(--navy); font: 700 14px "Manrope", sans-serif; }
.address-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 11px; }
.address-form-grid .full { grid-column: 1 / -1; }
.tracking-card { box-shadow: none; }
.tracking-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.tracking-head h2 { margin: 4px 0 0; color: var(--navy); font: 800 16px "Manrope", sans-serif; }
.tracking-status { padding: 7px 10px; border-radius: 20px; background: #e4f4ec; color: #167b68; font-size: 10px; font-weight: 700; }
.tracking-date { margin: 10px 0; color: var(--muted); font-size: 10px; }
.tracking-steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); padding: 0; margin: 17px 0; list-style: none; }
.tracking-steps li { position: relative; display: grid; justify-items: center; gap: 7px; color: #84928e; text-align: center; font-size: 9px; }
.tracking-steps li:not(:last-child)::after { content: ""; position: absolute; top: 13px; left: calc(50% + 16px); width: calc(100% - 32px); height: 2px; background: var(--line); }
.tracking-step-dot { z-index: 1; display: grid; place-items: center; width: 27px; height: 27px; border: 1px solid #d6e0db; border-radius: 50%; background: white; font-size: 10px; }
.tracking-steps li.is-complete { color: var(--teal-deep); }
.tracking-steps li.is-complete .tracking-step-dot { border-color: var(--teal-deep); background: var(--teal-deep); color: white; }
.tracking-steps li.is-current { color: var(--navy); font-weight: 700; }
.tracking-steps li.is-current .tracking-step-dot { box-shadow: 0 0 0 4px rgba(22,123,104,.12); }
.tracking-items { display: grid; gap: 8px; padding: 12px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.tracking-items > div { display: flex; justify-content: space-between; gap: 12px; color: var(--muted); font-size: 10px; }
.tracking-items strong { color: var(--navy); }
.tracking-disclaimer { color: var(--muted); font-size: 9px; line-height: 1.5; }
.tracking-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.tracking-actions .button { min-height: 36px; padding-inline: 12px; font-size: 10px; }
.notification-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 13px; color: var(--muted); font-size: 11px; }
.notification-toolbar .button { min-height: 36px; padding-inline: 12px; font-size: 10px; }
.notification-item { display: grid; grid-template-columns: 38px minmax(0,1fr) auto; align-items: start; gap: 12px; box-shadow: none; }
.notification-item.is-read { opacity: .75; }
.notification-type-icon { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px; background: #edf6f2; color: var(--teal-deep); }
.notification-copy p { margin: 6px 0; color: var(--muted); font-size: 11px; line-height: 1.55; }
.notification-copy small, .notification-item-head time { color: var(--muted); font-size: 9px; }
.notification-item-head { display: flex; justify-content: space-between; gap: 10px; }
.notification-item-head strong { color: var(--navy); font-size: 11px; }
.notification-actions { display: flex; align-items: flex-end; flex-direction: column; gap: 8px; }
.notification-actions .button { min-height: 31px; padding-inline: 9px; font-size: 9px; }
.notification-actions .remove-button { padding: 5px; }
.faq-panel, .support-contact { margin-bottom: 14px; }
.faq-category h3 { margin: 15px 0 7px; color: var(--teal-deep); font: 700 11px "Manrope", sans-serif; }
.faq-item { border-bottom: 1px solid var(--line); }
.faq-item summary { padding: 12px 2px; color: var(--navy); cursor: pointer; font-size: 11px; font-weight: 700; }
.faq-item summary::marker { color: var(--teal-deep); }
.faq-item p { margin: 0; padding: 0 2px 12px; color: var(--muted); font-size: 11px; line-height: 1.7; }

:root[data-theme="dark"] .catalog-filters,
:root[data-theme="dark"] .feature-panel { border-color: var(--settings-border); background: var(--settings-surface); color: var(--settings-text); }
:root[data-theme="dark"] .filter-control { color: var(--settings-subtle); }
:root[data-theme="dark"] .filter-control input,
:root[data-theme="dark"] .filter-control select,
:root[data-theme="dark"] .feature-field input,
:root[data-theme="dark"] .feature-field textarea,
:root[data-theme="dark"] #saved-shipping-address { border-color: var(--settings-border); background: var(--settings-surface-soft); color: var(--settings-text); }
:root[data-theme="dark"] .feature-section-heading,
:root[data-theme="dark"] .review-item,
:root[data-theme="dark"] .tracking-items,
:root[data-theme="dark"] .faq-item { border-color: var(--settings-border); }
:root[data-theme="dark"] .feature-section-heading h2,
:root[data-theme="dark"] .review-item-head strong,
:root[data-theme="dark"] .review-item p,
:root[data-theme="dark"] .tracking-head h2,
:root[data-theme="dark"] .tracking-items strong,
:root[data-theme="dark"] .notification-item-head strong,
:root[data-theme="dark"] .faq-item summary,
:root[data-theme="dark"] .saved-address strong,
:root[data-theme="dark"] .account-shortcuts > a span { color: var(--settings-text); }
:root[data-theme="dark"] .feature-empty { border-color: var(--settings-border); background: rgba(24,37,48,.72); }
:root[data-theme="dark"] .saved-address { border-color: var(--settings-border); }
:root[data-theme="dark"] .account-shortcuts > a:hover { background: var(--settings-surface-soft); }
:root[data-theme="dark"] .favorite-toggle { border-color: var(--settings-border); background: rgba(24,37,48,.95); color: #d1e0e5; }
:root[data-theme="dark"] .favorite-toggle.is-favorite,
:root[data-theme="dark"] .favorite-detail { color: #ff8e9a; }
:root[data-theme="dark"] .tracking-status { background: #203a34; color: #91e0c1; }
:root[data-theme="dark"] .tracking-step-dot { border-color: var(--settings-border); background: var(--settings-surface-soft); color: var(--settings-subtle); }
:root[data-theme="dark"] .tracking-steps li.is-complete .tracking-step-dot { border-color: #176b5c; background: #176b5c; color: #fff; }
:root[data-theme="dark"] .notification-type-icon { background: #29453f; color: #91e0c1; }
:root[data-theme="dark"] .notification-link:hover { background: #202f3a; }
:root[data-theme="dark"] .notification-count { border-color: #182530; }

@media (max-width: 900px) {
  .catalog-filters { grid-template-columns: repeat(3, minmax(0,1fr)); }
  .filter-clear { justify-self: start; }
  .notification-link { margin-left: 2px; }
}
@media (max-width: 680px) {
  .category-inner { gap: 17px; }
  .feature-nav-link { font-size: 10px; }
  .feature-nav-link span { display: none; }
  .notification-link { width: 25px; }
  .account-grid { grid-template-columns: 1fr; }
  .notification-item { grid-template-columns: 32px minmax(0,1fr); }
  .notification-type-icon { width: 32px; height: 32px; }
  .notification-actions { grid-column: 2; flex-direction: row; align-items: center; }
}
@media (max-width: 520px) {
  .catalog-filters { grid-template-columns: repeat(2, minmax(0,1fr)); padding: 11px; }
  .filter-sort { grid-column: 1 / -1; }
  .filter-clear { grid-column: 1 / -1; }
  .feature-panel { padding: 16px; }
  .tracking-steps { gap: 3px; }
  .tracking-steps li { font-size: 8px; }
  .tracking-steps li:not(:last-child)::after { left: calc(50% + 13px); width: calc(100% - 26px); }
  .tracking-step-dot { width: 23px; height: 23px; }
  .address-form-grid { grid-template-columns: 1fr; }
  .address-form-grid .full { grid-column: auto; }
  .saved-address { flex-direction: column; }
  .notification-item-head { flex-direction: column; gap: 3px; }
  .notification-toolbar { align-items: flex-start; flex-direction: column; }
}

/* Pulido visual global: conserva los componentes y sus interacciones existentes. */
:root {
  --shadow: 0 12px 32px rgba(25, 49, 65, .075);
  --surface-hover: #f5f9f7;
  --focus-ring: 0 0 0 3px rgba(22, 123, 104, .2);
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
body { line-height: 1.55; }
button, a, input, select, textarea { -webkit-tap-highlight-color: transparent; }
:where(a, button, input, select, textarea, summary):focus-visible {
  outline: 3px solid rgba(22, 123, 104, .46);
  outline-offset: 3px;
}
.announcement { font-size: 11px; font-weight: 500; letter-spacing: .025em; }
.site-header { background: rgba(255,255,255,.96); box-shadow: 0 1px 0 rgba(23,43,58,.07); }
.header-main { min-height: 78px; gap: clamp(18px, 3vw, 38px); }
.header-actions { gap: clamp(11px, 1.7vw, 22px); }
.account-slot, #account-slot { gap: clamp(8px, 1.1vw, 13px); }
.text-action, .signin-link, .register-link, .cart-link { font-size: 12px; font-weight: 600; }
.text-action, .signin-link, .register-link, .cart-link, .feature-nav-link { transition: color .18s ease, background-color .18s ease; }
.search-form { border-color: #dbe5e1; background: #f7faf8; }
.search-form button { position: relative; width: 45px; flex: 0 0 45px; color: transparent; font-size: 0; }
.search-form button::before { content: ""; position: absolute; top: 12px; left: 14px; width: 11px; height: 11px; border: 2px solid var(--navy); border-radius: 50%; }
.search-form button::after { content: ""; position: absolute; top: 24px; left: 26px; width: 7px; height: 2px; border-radius: 2px; background: var(--navy); transform: rotate(48deg); transform-origin: left center; }
.search-form button:hover { background: rgba(22,123,104,.07); }
.cart-link { gap: 7px; }
.cart-icon { position: relative; display: inline-block; width: 22px; height: 22px; transform: none; color: transparent; font-size: 0; }
.cart-icon::before { content: ""; position: absolute; top: 6px; left: 5px; width: 13px; height: 9px; border: 1.8px solid var(--navy); border-top: 0; border-radius: 0 0 3px 3px; transform: skew(-9deg); }
.cart-icon::after { content: ""; position: absolute; top: 16px; left: 7px; width: 4px; height: 4px; border-radius: 50%; background: var(--navy); box-shadow: 9px 0 0 var(--navy); }
.notification-link { width: 34px; height: 34px; border: 1px solid transparent; transition: background-color .18s ease, border-color .18s ease; }
.notification-link > span:first-child { position: relative; display: inline-block; width: 18px; height: 19px; color: transparent; font-size: 0; }
.notification-link > span:first-child::before { content: ""; position: absolute; top: 2px; left: 3px; width: 12px; height: 13px; border: 1.7px solid var(--navy); border-radius: 8px 8px 4px 4px; }
.notification-link > span:first-child::after { content: ""; position: absolute; top: 16px; left: 6px; width: 7px; height: 2px; border-radius: 0 0 4px 4px; background: var(--navy); box-shadow: 3px 2px 0 -0.4px var(--navy); }
.notification-link:hover { border-color: var(--line); background: var(--surface-hover); }
.notification-count { right: -4px; top: -4px; }
.category-nav { background: rgba(255,255,255,.74); }
.category-inner { min-height: 46px; gap: clamp(14px, 2vw, 25px); }
.category-button { font-size: 12px; font-weight: 600; }
.feature-nav-link { min-height: 34px; gap: 6px; padding: 0 2px; font-size: 11px; }
.feature-nav-link:hover { color: var(--teal-deep); }
.feature-nav-link > span { font-size: inherit; }
.page-content { padding-top: 34px; }
.hero { min-height: 360px; border-radius: 18px; box-shadow: 0 8px 28px rgba(24, 56, 68, .045); }
.hero-copy { padding-left: clamp(30px, 5vw, 58px); }
.hero h1 { max-width: 460px; font-size: clamp(34px, 4.1vw, 48px); line-height: 1.12; letter-spacing: -.05em; }
.hero-copy > p:not(.eyebrow) { font-size: 14px; line-height: 1.75; }
.eyebrow { font-size: 10px; letter-spacing: .15em; }
.section-heading { margin-top: 38px; margin-bottom: 19px; }
.section-heading h2 { font-size: 24px; letter-spacing: -.035em; }
.section-heading p, .page-intro { line-height: 1.65; }
.product-grid { gap: 17px; }
.product-card { display: flex; flex-direction: column; border-color: #e9efec; border-radius: 13px; }
.product-card-media { flex: 0 0 auto; }
.product-card-image { aspect-ratio: 1.12; }
.product-card-image img { object-position: center; }
.product-card-body { display: flex; flex: 1; flex-direction: column; padding: 14px 15px 15px; }
.product-card h3 { min-height: 40px; margin: 6px 0 8px; font-size: 13px; line-height: 1.45; letter-spacing: -.015em; }
.product-card-rating { margin-top: auto; padding-top: 2px; }
.product-card-bottom { min-height: 35px; }
.price { font-variant-numeric: tabular-nums; letter-spacing: -.015em; }
.old-price { color: #87958f; font-variant-numeric: tabular-nums; }
.quick-add { width: 35px; height: 35px; border: 1px solid rgba(22,123,104,.12); border-radius: 10px; font-size: 20px; transition: color .16s ease, background-color .16s ease, transform .16s ease; }
.quick-add:hover { transform: translateY(-1px); }
.favorite-toggle { width: 36px; height: 36px; box-shadow: 0 3px 12px rgba(17,39,53,.12); transition: color .16s ease, background-color .16s ease, transform .16s ease; }
.favorite-toggle:hover { transform: scale(1.06); }
.product-tag { padding: 6px 10px; font-size: 9px; letter-spacing: .025em; box-shadow: 0 2px 9px rgba(17,39,53,.06); }
.button { min-height: 43px; border-radius: 9px; font-size: 12px; letter-spacing: .005em; transition: transform .16s ease, background-color .16s ease, border-color .16s ease, color .16s ease, box-shadow .16s ease; }
.button:active, .quick-add:active, .favorite-toggle:active { transform: translateY(0) scale(.98); }
.button-primary { box-shadow: 0 3px 8px rgba(16,42,67,.08); }
.button-outline { border-color: #d7e2dd; }
.benefit-row { gap: 13px; margin-top: 25px; }
.benefit { min-height: 74px; padding: 15px 16px; border-color: #e8eeeb; }
.benefit-icon { width: 38px; height: 38px; flex-basis: 38px; border-radius: 12px; }
.page-heading { font-size: clamp(26px, 3vw, 31px); line-height: 1.2; letter-spacing: -.045em; }
.page-intro { margin-bottom: 23px; font-size: 13px; }
.auth-card, .panel, .summary-card, .feature-panel, .settings-card { border-radius: 13px; box-shadow: 0 5px 18px rgba(25,49,65,.035); }
.field input, .field select, .field textarea, .feature-field input, .feature-field textarea, .filter-control input, .filter-control select {
  border-color: #d9e3df;
  border-radius: 8px;
  transition: border-color .16s ease, box-shadow .16s ease, background-color .16s ease;
}
.field input:focus, .field select:focus, .field textarea:focus,
.feature-field input:focus, .feature-field textarea:focus,
.filter-control input:focus, .filter-control select:focus { box-shadow: var(--focus-ring); }
.product-detail { gap: clamp(24px, 4vw, 46px); padding: clamp(16px, 2.4vw, 25px); border-radius: 15px; }
.product-detail-image { border-radius: 11px; }
.product-title { font-size: clamp(26px, 3.1vw, 35px); line-height: 1.17; }
.detail-description { font-size: 13px; line-height: 1.8; }
.detail-price { font-size: 25px; }
.trust-note { font-size: 10px; }
.cart-item, .order-card { border-color: #e7eeea; border-radius: 11px; }
.summary-card { padding: 22px; }
.summary-line { font-size: 11px; }
.summary-total { font-size: 14px; }
.stepper { margin-bottom: 22px; }
.checkout-panel h2 { font-size: 18px; }
.payment-option { border-radius: 9px; transition: border-color .16s ease, background-color .16s ease; }
.payment-option:hover { border-color: #a9c7ba; }
.success-banner { border-radius: 14px; }
.order-info { border-radius: 10px; }
.toast { border-radius: 9px; box-shadow: 0 10px 30px rgba(25,49,65,.12); }
.catalog-filters { gap: 11px; padding: 16px; border-color: #e3ebe7; border-radius: 12px; box-shadow: 0 4px 16px rgba(25,49,65,.025); }
.filter-control { gap: 6px; }
.filter-control > span { color: #526571; font-size: 10px; font-weight: 700; }
.filter-control input, .filter-control select { height: 40px; padding-inline: 11px; }
.filter-clear { height: 40px; }
.feature-panel { padding: 22px; }
.feature-section-heading h2 { font-size: 18px; }
.feature-section-heading p { font-size: 11px; }
.tracking-status { letter-spacing: .01em; }
.tracking-steps li { line-height: 1.35; }
.tracking-items { padding-block: 13px; }
.faq-item summary { line-height: 1.5; }
.site-footer { background: #fff; }
.footer-inner { line-height: 1.6; }

/* El mismo pulido conserva contraste y jerarquía en el tema oscuro. */
:root[data-theme="dark"] {
  --surface-hover: #202f3a;
  --focus-ring: 0 0 0 3px rgba(101,197,165,.28);
  --shadow: 0 12px 32px rgba(0,0,0,.24);
}
:root[data-theme="dark"] .site-header,
:root[data-theme="dark"] .category-nav { background: rgba(20,32,43,.97); }
:root[data-theme="dark"] .search-form { border-color: #344653; background: #1b2a35; }
:root[data-theme="dark"] .search-form button::before { border-color: #e7f0f5; }
:root[data-theme="dark"] .search-form button::after { background: #e7f0f5; }
:root[data-theme="dark"] .cart-icon::before { border-color: #e7f0f5; }
:root[data-theme="dark"] .cart-icon::after { background: #e7f0f5; box-shadow: 9px 0 0 #e7f0f5; }
:root[data-theme="dark"] .notification-link > span:first-child::before { border-color: #e7f0f5; }
:root[data-theme="dark"] .notification-link > span:first-child::after { background: #e7f0f5; box-shadow: 3px 2px 0 -0.4px #e7f0f5; }
:root[data-theme="dark"] .notification-link:hover { border-color: #344653; background: #202f3a; }
:root[data-theme="dark"] .button-outline { border-color: #3a4b57; background: #202f3a; }
:root[data-theme="dark"] .catalog-filters { border-color: #30414d; }
:root[data-theme="dark"] .filter-control > span { color: #b0bec7; }
:root[data-theme="dark"] .product-card { border-color: #30414d; }
:root[data-theme="dark"] .feature-empty { border-color: #3b4b55; }
:root[data-theme="dark"] .site-footer { background: #182530; }

@media (max-width: 900px) {
  .header-main { gap: 18px; }
  .feature-nav-link { padding-inline: 0; }
}
@media (max-width: 680px) {
  .announcement { padding: 8px 12px; }
  .header-main { gap: 9px 10px; }
  .header-actions { gap: 9px; }
  .search-form { border-radius: 10px; }
  .category-inner { gap: 17px; }
  .page-content { padding-top: 22px; }
  .hero { border-radius: 14px; }
  .hero-copy { padding: 27px 22px 22px; }
  .hero h1 { font-size: clamp(30px, 8vw, 36px); }
  .section-heading { margin-top: 30px; }
  .product-grid { gap: 12px; }
  .product-card { border-radius: 11px; }
  .product-card-body { padding: 12px; }
  .product-card h3 { font-size: 12px; }
  .feature-panel { padding: 17px; }
  .summary-card { padding: 17px; }
  .settings-card { padding: 17px; }
}
@media (max-width: 390px) {
  .header-actions { gap: 7px; }
  .account-slot, #account-slot { gap: 6px; }
  .notification-link { width: 29px; }
  .cart-link { gap: 4px; }
  .cart-link > span:not(.cart-icon):not(.cart-count) { font-size: 10px; }
  .product-grid { gap: 9px; }
  .product-card-body { padding: 10px; }
  .quick-add { width: 32px; height: 32px; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}
@media (max-width: 350px) {
  .header-actions { gap: 5px; }
  .account-slot, #account-slot { gap: 5px; }
  .cart-link > span:not(.cart-icon):not(.cart-count) { display: none; }
}